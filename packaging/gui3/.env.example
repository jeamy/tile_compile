# GUI3 launcher example environment.
# The launcher scripts do not auto-load this file.
# Usage on Linux/macOS:
#   set -a
#   source packaging/gui3/.env.example
#   set +a
#   packaging/gui3/start_gui3.sh
#
# Usage on Windows PowerShell:
#   Get-Content packaging/gui3/.env.example | ForEach-Object {
#     if ($_ -match '^\s*#' -or $_ -notmatch '=') { return }
#     $name, $value = $_ -split '=', 2
#     [Environment]::SetEnvironmentVariable($name, $value)
#   }
#   .\packaging\gui3\start_gui3.ps1

# GUI3 launcher behavior
TILE_COMPILE_GUI3_PORT=8080
TILE_COMPILE_GUI3_NO_BROWSER=0

# Optional report locale
TILE_COMPILE_REPORT_LOCALE=de

# Backend memory guards
TILE_COMPILE_BACKEND_SUBPROCESS_CAPTURE_BYTES=1048576
TILE_COMPILE_BACKEND_JOB_STDIO_STORE_BYTES=131072
TILE_COMPILE_BACKEND_SCAN_FRAMES_PREVIEW=256
TILE_COMPILE_BACKEND_SCAN_PER_DIR_FRAMES_PREVIEW=32
TILE_COMPILE_BACKEND_SCAN_PER_DIR_RESULTS_PREVIEW=64
TILE_COMPILE_BACKEND_SCAN_MESSAGES_PREVIEW=128
TILE_COMPILE_BACKEND_SCAN_COLOR_CANDIDATES_PREVIEW=32
TILE_COMPILE_BACKEND_REPORT_EVENTS_MAX=4096
TILE_COMPILE_BACKEND_REPORT_LOG_TAIL=128
TILE_COMPILE_BACKEND_REPORT_TEXT_BYTES=262144
TILE_COMPILE_BACKEND_REPORT_JSON_FILE_BYTES=4194304
TILE_COMPILE_BACKEND_RETAINED_JOBS=128
