# tile_compile PI Scan-AI example environment
# Copy to .env (project root) and fill only the providers you actually use.
# Do not commit real API keys.

# ---------------------------------------------------------------------
# Docker / start_gui3_docker settings
# Used by start_gui3_docker.sh and .bat for host mount paths.
# ---------------------------------------------------------------------
INPUT_DIR=
RUNS_DIR=
ASTAP_DATA_DIR=
SIRIL_CATALOG_DIR=
HOST_PORT=8080
#IMAGE_TAG=tile-compile-web-backend:ubuntu24.04
#CONTAINER_NAME=tile-compile-web-backend
#EXTRA_ALLOWED_ROOTS=

# ---------------------------------------------------------------------
# Native GUI3 / C++ backend runtime settings
# Docker maps the host values above to these TILE_COMPILE_* variables
# inside the container. For native runs, set these directly if defaults
# are not sufficient.
# ---------------------------------------------------------------------
TILE_COMPILE_PROJECT_ROOT=
TILE_COMPILE_RUNS_DIR=
TILE_COMPILE_INPUT_DIR=
TILE_COMPILE_INPUT_SEARCH_ROOTS=
TILE_COMPILE_ALLOWED_ROOTS=
TILE_COMPILE_ASTAP_DATA_DIR=
TILE_COMPILE_SIRIL_CATALOG_DIR=
TILE_COMPILE_RUNTIME_DIR=
TILE_COMPILE_UI_DIR=
TILE_COMPILE_CONFIG=
TILE_COMPILE_SCHEMA=
TILE_COMPILE_PRESETS_DIR=
TILE_COMPILE_CLI=
TILE_COMPILE_RUNNER=
TILE_COMPILE_HOST=127.0.0.1
TILE_COMPILE_PORT=8000

# Optional backend preview/retention limits. Leave empty for compiled defaults.
TILE_COMPILE_BACKEND_SUBPROCESS_CAPTURE_BYTES=
TILE_COMPILE_BACKEND_JOB_STDIO_STORE_BYTES=
TILE_COMPILE_BACKEND_SCAN_FRAMES_PREVIEW=
TILE_COMPILE_BACKEND_SCAN_PER_DIR_FRAMES_PREVIEW=
TILE_COMPILE_BACKEND_SCAN_PER_DIR_RESULTS_PREVIEW=
TILE_COMPILE_BACKEND_SCAN_MESSAGES_PREVIEW=
TILE_COMPILE_BACKEND_SCAN_COLOR_CANDIDATES_PREVIEW=
TILE_COMPILE_BACKEND_REPORT_EVENTS_MAX=
TILE_COMPILE_BACKEND_REPORT_LOG_TAIL=
TILE_COMPILE_BACKEND_REPORT_TEXT_BYTES=
TILE_COMPILE_BACKEND_REPORT_JSON_FILE_BYTES=
TILE_COMPILE_BACKEND_RETAINED_JOBS=

# ---------------------------------------------------------------------
# Scan-AI / PI sidecar defaults
# ---------------------------------------------------------------------
AI_SCAN_ENABLED=false
AI_SCAN_MODEL=
AI_RESEARCH_MODEL=
AI_SCAN_MAX_TOKENS=16000
AI_SCAN_TEMPERATURE=1
#AI_SCAN_MAX_TOKENS=8000
#AI_SCAN_TEMPERATURE=0.2
AI_SCAN_TIMEOUT_MS=180000
AI_TRAFFIC_LOG=true
AI_TRAFFIC_LOG_PATH=
TILE_COMPILE_PI_TRAFFIC_LOG_PATH=

# C++ backend -> local PI sidecar
AI_AGENT_URL=http://127.0.0.1:3001

# PI sidecar listener
AI_AGENT_HOST=127.0.0.1
AI_AGENT_PORT=3001
TILE_COMPILE_AI_AGENT_AUTOSTART=1

# ---------------------------------------------------------------------
# Core API-key providers supported by the PI sidecar.
# These names intentionally match agent_service/src/config.ts.
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANT_LING_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
ZAI_API_KEY=
ZAI_CODING_CN_API_KEY=
OPENCODE_API_KEY=
HF_TOKEN=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
XIAOMI_API_KEY=
XIAOMI_TOKEN_PLAN_CN_API_KEY=
XIAOMI_TOKEN_PLAN_AMS_API_KEY=
XIAOMI_TOKEN_PLAN_SGP_API_KEY=

# Optional provider base URLs / account settings
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME_MAP=
GOOGLE_CLOUD_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=

# ---------------------------------------------------------------------
# Amazon Bedrock / AWS-backed PI providers
# ---------------------------------------------------------------------
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
AWS_WEB_IDENTITY_TOKEN_FILE=
AWS_ROLE_ARN=
AWS_CONTAINER_CREDENTIALS_RELATIVE_URI=
AWS_CONTAINER_CREDENTIALS_FULL_URI=
AWS_BEDROCK_FORCE_CACHE=
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=
AWS_BEDROCK_SKIP_AUTH=
AWS_BEDROCK_FORCE_HTTP1=
